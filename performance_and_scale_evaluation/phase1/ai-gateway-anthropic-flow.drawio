<mxfile host="app.diagrams.net" modified="2026-04-27T07:40:00.000Z" agent="Cursor" version="24.0.0" type="device">
  <diagram id="ai-gateway-anthropic-flow" name="AI Gateway - Anthropic Flow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cluster boundary -->
        <mxCell id="cluster" value="OpenShift Cluster — namespace: openshift-ingress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=5;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="1120" as="geometry" />
        </mxCell>

        <!-- ==================== GuideLLM Pod ==================== -->
        <mxCell id="guidellm" value="&lt;b&gt;GuideLLM Pod&lt;/b&gt;&lt;br&gt;(load generator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== Envoy Pod (gateway) ==================== -->
        <mxCell id="envoy_box" value="&lt;b&gt;Envoy Pod&lt;/b&gt; (maas-default-gateway)&lt;br&gt;Port :80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;fontSize=13;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="880" height="460" as="geometry" />
        </mxCell>

        <!-- Filter 1: Kuadrant WASM -->
        <mxCell id="filter1" value="&lt;b&gt;EnvoyFilter #1&lt;/b&gt;&lt;br&gt;Kuadrant WASM&lt;br&gt;&lt;i&gt;Auth + Rate Limiting&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="260" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Filter 2: ext_proc -->
        <mxCell id="filter_extproc" value="&lt;b&gt;EnvoyFilter #3&lt;/b&gt;&lt;br&gt;ext_proc&lt;br&gt;&lt;i&gt;Calls payload-processing&lt;br&gt;via gRPC&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="390" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Filter 3: Router -->
        <mxCell id="filter_router" value="&lt;b&gt;Router&lt;/b&gt; (built-in, always last)&lt;br&gt;&lt;i&gt;HTTPRoute match:&lt;/i&gt;&lt;br&gt;/claude-sonnet-anthropic/* → rewrite /&lt;br&gt;backend: sim:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Authorino Pod -->
        <mxCell id="authorino" value="&lt;b&gt;Authorino Pod&lt;/b&gt;&lt;br&gt;(kuadrant-system ns)&lt;br&gt;&lt;br&gt;Validates SA token&lt;br&gt;audience:&lt;br&gt;maas-default-gateway-sa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="230" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== payload-processing Pod ==================== -->
        <mxCell id="pp_box" value="&lt;b&gt;payload-processing Pod&lt;/b&gt;&lt;br&gt;gRPC :9004" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;fontSize=13;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1040" y="370" width="480" height="280" as="geometry" />
        </mxCell>

        <!-- Plugin 1 -->
        <mxCell id="p1" value="&lt;b&gt;1. model-extractor&lt;/b&gt;&lt;br&gt;Reads &quot;model&quot; from body&lt;br&gt;→ header: x-model=claude-sonnet-anthropic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="410" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Plugin 2 -->
        <mxCell id="p2" value="&lt;b&gt;2. model-provider-resolver&lt;/b&gt;&lt;br&gt;Lookups ExternalModel CRD&lt;br&gt;→ provider=&lt;b&gt;anthropic&lt;/b&gt;&lt;br&gt;→ credentialRef=anthropic-creds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="410" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Plugin 3 -->
        <mxCell id="p3" value="&lt;b&gt;3. api-translation ✦ REQUEST&lt;/b&gt;&lt;br&gt;Provider=anthropic, so CONVERTS body:&lt;br&gt;&lt;br&gt;OpenAI format → Anthropic format&lt;br&gt;{messages:[...]} → {prompt:&quot;...&quot;, max_tokens:...}&lt;br&gt;Adds header: x-api-key, anthropic-version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="480" width="450" height="75" as="geometry" />
        </mxCell>

        <!-- Plugin 4 -->
        <mxCell id="p4" value="&lt;b&gt;4. apikey-injection&lt;/b&gt;&lt;br&gt;Reads Secret &quot;anthropic-creds&quot;&lt;br&gt;Injects: x-api-key: sk-ant-xxx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="570" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Response plugin -->
        <mxCell id="p5" value="&lt;b&gt;api-translation ✦ RESPONSE&lt;/b&gt;&lt;br&gt;Anthropic format → OpenAI format&lt;br&gt;{content:[...]} → {choices:[{message:...}]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="570" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Plugin arrows -->
        <mxCell id="pp_arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp_arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="p2" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pp_arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" source="p3" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== Simulator Pod ==================== -->
        <mxCell id="sim" value="&lt;b&gt;llm-d-inference-sim Pod&lt;/b&gt;&lt;br&gt;Port :8000&lt;br&gt;&lt;br&gt;Receives request in &lt;b&gt;Anthropic format&lt;/b&gt;&lt;br&gt;Responds in &lt;b&gt;Anthropic format&lt;/b&gt;&lt;br&gt;(TTFT=100ms, ITL=30ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="750" width="260" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== istiod Pod ==================== -->
        <mxCell id="istiod" value="&lt;b&gt;istiod Pod&lt;/b&gt;&lt;br&gt;(control plane)&lt;br&gt;&lt;br&gt;Watches: Gateway, HTTPRoute,&lt;br&gt;EnvoyFilter CRDs&lt;br&gt;Pushes config to Envoy via xDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- istiod -> envoy dashed -->
        <mxCell id="istiod_arrow" value="xDS config push" style="endArrow=block;dashed=1;endFill=1;strokeColor=#999999;fontSize=10;fontColor=#999999;" edge="1" source="istiod" target="envoy_box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== REQUEST PATH ARROWS (blue) ==================== -->

        <!-- Step 1: GuideLLM -> Envoy -->
        <mxCell id="arrow1" value="" style="endArrow=block;endFill=1;strokeColor=#0000FF;strokeWidth=2;" edge="1" source="guidellm" target="filter1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label1" value="① POST /claude-sonnet-anthropic/v1/chat/completions&lt;br&gt;Body (OpenAI format): {model:claude-sonnet-anthropic, messages:[...]}&lt;br&gt;Header: Authorization: Bearer &amp;lt;SA-token&amp;gt;" style="edgeLabel;html=1;align=left;fontSize=10;fontColor=#0000FF;" vertex="1" connectable="0" parent="arrow1">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="130" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2: Filter1 -> Authorino -->
        <mxCell id="arrow2" value="② Is token valid?" style="endArrow=block;endFill=1;strokeColor=#0000FF;strokeWidth=2;fontSize=10;fontColor=#0000FF;" edge="1" source="filter1" target="authorino" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Authorino -> Filter1 -->
        <mxCell id="arrow3" value="③ YES, valid" style="endArrow=block;endFill=1;strokeColor=#00AA00;strokeWidth=2;fontSize=10;fontColor=#00AA00;dashed=1;" edge="1" source="authorino" target="filter1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Filter1 -> ext_proc -->
        <mxCell id="arrow4" value="" style="endArrow=block;endFill=1;strokeColor=#0000FF;strokeWidth=2;" edge="1" source="filter1" target="filter_extproc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: ext_proc -> payload-processing -->
        <mxCell id="arrow5" value="④ gRPC: headers + body" style="endArrow=block;endFill=1;strokeColor=#0000FF;strokeWidth=2;fontSize=10;fontColor=#0000FF;" edge="1" source="filter_extproc" target="pp_box" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Step 6: payload-processing -> ext_proc (return) -->
        <mxCell id="arrow6" value="⑤ gRPC: modified headers + converted body (Anthropic format)" style="endArrow=block;endFill=1;strokeColor=#9933FF;strokeWidth=2;fontSize=10;fontColor=#9933FF;dashed=1;" edge="1" source="pp_box" target="filter_extproc" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="10" as="offset" />
            <Array as="points">
              <mxPoint x="960" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 7: ext_proc -> router -->
        <mxCell id="arrow7" value="" style="endArrow=block;endFill=1;strokeColor=#0000FF;strokeWidth=2;" edge="1" source="filter_extproc" target="filter_router" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 8: Router -> Simulator -->
        <mxCell id="arrow8" value="" style="endArrow=block;endFill=1;strokeColor=#0000FF;strokeWidth=2;" edge="1" source="filter_router" target="sim" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label8" value="⑥ POST /v1/chat/completions&lt;br&gt;Body (&lt;b&gt;Anthropic format&lt;/b&gt;): {prompt:..., max_tokens:...}&lt;br&gt;Header: x-api-key: sk-ant-xxx, anthropic-version: 2023-06-01" style="edgeLabel;html=1;align=left;fontSize=10;fontColor=#0000FF;" vertex="1" connectable="0" parent="arrow8">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <mxPoint x="140" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== RESPONSE PATH ARROWS (green) ==================== -->

        <!-- Step 9: Simulator -> Envoy -->
        <mxCell id="arrow9" value="" style="endArrow=block;endFill=1;strokeColor=#00AA00;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="800" as="sourcePoint" />
            <mxPoint x="400" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label9" value="⑦ HTTP 200 — Body (&lt;b&gt;Anthropic format&lt;/b&gt;):&lt;br&gt;{content:[{type:text, text:&quot;Hello! How can I help?&quot;}], stop_reason:end_turn}" style="edgeLabel;html=1;align=left;fontSize=10;fontColor=#00AA00;" vertex="1" connectable="0" parent="arrow9">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="-280" y="-10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Step 10: Envoy -> payload-processing (response) -->
        <mxCell id="arrow10" value="⑧ gRPC: response headers + body" style="endArrow=block;endFill=1;strokeColor=#00AA00;strokeWidth=2;fontSize=10;fontColor=#00AA00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="630" as="sourcePoint" />
            <mxPoint x="1290" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 11: payload-processing -> Envoy (response modified) -->
        <mxCell id="arrow11" value="⑨ gRPC: converted response (&lt;b&gt;OpenAI format&lt;/b&gt;)&lt;br&gt;{choices:[{message:{content:&quot;Hello! How can I help?&quot;}}]}" style="endArrow=block;endFill=1;strokeColor=#FF6600;strokeWidth=2;fontSize=10;fontColor=#FF6600;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1290" y="620" as="sourcePoint" />
            <mxPoint x="870" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 12: Envoy -> GuideLLM -->
        <mxCell id="arrow12" value="" style="endArrow=block;endFill=1;strokeColor=#00AA00;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="400" as="sourcePoint" />
            <mxPoint x="660" y="115" as="targetPoint" />
            <Array as="points">
              <mxPoint x="400" y="115" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label12" value="⑩ HTTP 200 — Body (&lt;b&gt;OpenAI format&lt;/b&gt;):&lt;br&gt;{id:chatcmpl-xxx, model:claude-sonnet-anthropic,&lt;br&gt; choices:[{message:{role:assistant, content:&quot;Hello!...&quot;}}]}" style="edgeLabel;html=1;align=left;fontSize=10;fontColor=#00AA00;" vertex="1" connectable="0" parent="arrow12">
          <mxGeometry x="0.5" relative="1" as="geometry">
            <mxPoint x="-170" y="-40" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Legend ==================== -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="900" width="350" height="200" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="→ Request path (OpenAI → Anthropic)" style="text;html=1;fontSize=11;fontColor=#0000FF;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="930" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="→ Response path (Anthropic → OpenAI)" style="text;html=1;fontSize=11;fontColor=#00AA00;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="955" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="⇢ Modified/returned data" style="text;html=1;fontSize=11;fontColor=#9933FF;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="980" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="&lt;br&gt;&lt;b&gt;Key insight:&lt;/b&gt; GuideLLM always speaks &lt;b&gt;OpenAI format&lt;/b&gt;.&lt;br&gt;The gateway translates to/from Anthropic format&lt;br&gt;transparently. GuideLLM never knows the backend&lt;br&gt;is an Anthropic-style provider." style="text;html=1;fontSize=11;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="1000" width="320" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
